NUMBER -> @INTEGER | @REAL;

//------------------EXPRESSION NODES------------------//

ATOM -> @IDENTIFIER | NUMBER | @STRING | "(" NODE ")" | "[" NODE ( "|" NODE )? "]" | 
"#[" NODE ( "|" NODE )? "]" | '`' ATOM | 'adrs' ATOM | `sizeof` ATOM;

//binary kinds
ARRAY -> ATOM ( '[' @INTEGER ']' )?; 
CALL -> ATOM ( "(" (NODE ("," NODE)*)? ")" )?;

DecideArrayOrCall -> CALL | ARRAY;

BINDING -> DecideArrayOrCall ('::' DecideArrayOrCall)*;
MAGNETIC -> BINDING ('->' BINDING)*;
ACCESS -> MAGNETIC ('.' MAGNETIC)*;
PRODUCT -> ACCESS (('*' | '/') ACCESS)*;
SUM -> PRODUCT (('-' | '+') PRODUCT)*;
INEQUALITY -> SUM (('<' | '>' | '<=' | '>=') SUM)*;
EQUALITY -> INEQUALITY (('==' | '!=') INEQUALITY)*;
ASSIGNMENT -> EQUALITY ('=' EQUALITY)*;


//------------------STATEMENT NODES------------------//

RETURN -> "return" ASSIGNMENT? ';';
BREAK -> "break" @IDENTIFIER? ';';

//@#--- Implemented till this portion, 29th July 2026

//refer language/type language/modifiers
LET -> modifiers.MODIFIER* "let" @IDENTIFIER ':' type.TYPE "=" NODE ';';
TRANSFORMER -> "transform" ASSIGNMENT "to" @IDENTIFIER ':' type.TYPE ';';
SUB -> "sub" NODE "with" NODE ';'; //zero-cost substitution

STATEMENT -> RETURN | BREAK | LET | TRANSFORMER | SUB;

//------------------MEMORY ALLOCATION------------------//

NEW -> "new" '<' @IDENTIFIER '>' ASSIGNMENT ';';
FREE -> "free" '<' @IDENTIFIER '>' ASSIGNMENT ';';

ALLOCATORS -> NEW | FREE;
//------------------ROOT------------------//

//root connector
NODE -> ASSIGNMENT | STATEMENT | ALLOCATORS;