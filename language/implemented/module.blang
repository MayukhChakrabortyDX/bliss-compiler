MODULE_ATOM -> @IDENTIFIER | '(' MODULE_PATH ( ',' MODULE_PATH )* ')' | "*";
MODULE_PATH -> MODULE_ATOM ('.' MODULE_ATOM)*;

//Module system
IMPORT -> "import" MODULE_PATH ';' ;
USING -> "using" MODULE_PATH ';' ;

//start(MODULE_PATH) = start(MODULE_ATOM)
EXPORT -> "export" "global"? node.Node ';';
//step 1 - add the export and local tokens
//step 2 - create parsers for them