//refer language/function
ACTION -> "action" @IDENTIFIER '{' 
    function.HEAD ';' 
    (function.HEAD ';')* 
'}';

DATA ->
    //named token
    "data" @IDENTIFIER ';' |

    //linear, refer language/type
    "data" @IDENTIFIER '(' type.TYPE ')' ';' |

    //array, refer language/node, refer language/type
    "data" @IDENTIFIER '[' type.TYPE ',' node.INTEGER ']' ';' |

    //struct-like
    "data" @IDENTIFIER '{' FIELD (FIELD)* '}'
;

//refer language/type
FIELD -> type.TYPE @IDENTIFIER ';';

BIND -> "bind" @IDENTIFIER "with" ( @IDENTIFIER | ('(' @IDENTIFIER (',' @IDENTIFIER)* ')') ) "as" @IDENTIFIER '{'
    function.FUNCTION (function.FUNCTION)*
'}';

ALIAS -> "alias" type.TYPE "as" @IDENTIFIER ';';

DAOP -> DATA | ACTION | BIND | ALIAS;