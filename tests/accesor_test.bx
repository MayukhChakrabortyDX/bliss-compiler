//let's say I have a circular linked list

data LinkedList {

    [LinkedList] left;
    [LinkedList] right;
    i32 value;

};

fx main(): void {

    transform malloc(sizeof LinkedList) to LinkedList: [LLType];
    transform malloc(sizeof LinkedList) to LinkedList: [LLType];
    [root].[left] = [root_left];

    //since root_left is unused, the compiler optimizes it towards a single allocation in C anyways

}